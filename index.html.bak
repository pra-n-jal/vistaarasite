            <button class="preset-chip-btn" data-preset="auto" type="button">Deep Tech & AI Focus</button>
            <button class="preset-chip-btn" data-preset="combat" type="button">Product & UX Heavy</button>
            <button class="preset-chip-btn" data-preset="max" type="button">Grand Champion Ceiling</button>
          </div>

          <div class="calc-grid">
            
            <div>
              <!-- 01: Problem Framing & Impact -->
              <div class="calc-section-title">01: Problem Framing & Real-World Impact (30 Pts)</div>
