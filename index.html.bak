              <option value="AI Central">AI Central (LLMs & Agentic Systems)</option>
              <option value="Cyber Security">Cyber Security (Defense & Auth)</option>
              <option value="Cloud Computing">Cloud Computing (Scale & Infra)</option>
              <option value="FinTech">FinTech (Payments & Inclusion)</option>
              <option value="Blockchain">Blockchain (Decentralized Ledgers)</option>
              <option value="Healthcare">Healthcare (BioTech & Diagnostics)</option>
              <option value="IoT">IoT (Smart Hardware & Sensors)</option>
              <option value="Web3">Web3 (Open Protocols & dApps)</option>
              <option value="Education">Education (EdTech & Learning Tools)</option>
              <option value="Sustainability">Sustainability (Climate & Green Tech)</option>
            </select>
          </div>
        </div>

        <div class="form-grid-2">
