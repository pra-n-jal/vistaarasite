  <div class="modal-backdrop" id="registrationModal" role="dialog" aria-modal="true" aria-labelledby="modalHeading">
    <div class="modal-window">
      
      <button class="modal-close-btn" id="modalCloseBtn" type="button" aria-label="Close Registration Modal">&times;</button>

      <div class="form-step-indicator">
        <div class="step-pill active" id="modalPill1"></div>
        <div class="step-pill" id="modalPill2"></div>
      </div>

      <!-- Step 1: Verification Code, Team & Category Entry -->
      <div class="modal-step-pane" id="modalStep1">
        <div class="hud-badge" style="margin-bottom: 10px; color: var(--blueprint); border-color: var(--blueprint);">
          STEP 01: VERIFICATION & CATEGORIES
        </div>
        <h3 id="modalHeading" style="font-size: 1.5rem; color: var(--ink); margin-bottom: 4px;">
          Generate Official Builder Pass
        </h3>
        
        <!-- 7 Oct 2026 Date Gating Notice & Countdown HUD -->
        <div class="pass-date-gate-banner" id="modalDateGateBanner">
          <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8px;">
            <div class="gate-status-pill locked" id="modalGateStatusPill">
              <span class="gate-status-dot"></span>
              <span id="modalGateStatusText">OPENS 7 OCT 2026 ONWARDS</span>
            </div>
            <div style="display: flex; gap: 6px; align-items: center; flex-wrap: wrap;">
              <button type="button" class="gate-toggle-preview-btn" id="modalTogglePreviewBtn">
                Unlock Demo Preview
              </button>
              <button type="button" class="pass-demo-code-btn" id="fillDemoCodeBtn">
                Use Demo Code (VST-2026-PASS)
              </button>
            </div>
          </div>

          <div class="gate-title" id="modalGateTitle">
            BUILDER PASS CLAIMING OPENS 7 OCTOBER 2026
          </div>

          <p class="gate-desc" id="modalGateDesc">
            As per official guidelines, unique team verification codes will be dispatched via email <strong>10 days before the event on 7 October 2026</strong>. The builder pass generator officially <strong>turns on on 7 October 2026 onwards</strong>. Check your registered inbox on 7 October to obtain your code and issue your official VIP Builder Credential.
          </p>

          <div class="gate-countdown-bar" id="modalCountdownBar">
            <div class="count-unit"><span class="count-val" id="modalCountDays">00</span><span class="count-lbl">DAYS</span></div>
            <span class="count-colon">:</span>
            <div class="count-unit"><span class="count-val" id="modalCountHours">00</span><span class="count-lbl">HOURS</span></div>
            <span class="count-colon">:</span>
            <div class="count-unit"><span class="count-val" id="modalCountMins">00</span><span class="count-lbl">MINS</span></div>
            <span class="count-colon">:</span>
            <div class="count-unit"><span class="count-val" id="modalCountSecs">00</span><span class="count-lbl">SECS</span></div>
          </div>
        </div>

        <div class="form-group">
          <label class="form-label" for="regPassCode">Unique Verification Code (From 10-Day Mail)</label>
          <input type="text" class="form-input" id="regPassCode" placeholder="e.g. VST-8842-X7" value="VST-2026-PASS" style="font-family: var(--font-mono); font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase;">
        </div>

        <div class="form-group">
          <label class="form-label" for="regTeamName">Team Call-Sign / Name</label>
          <input type="text" class="form-input" id="regTeamName" placeholder="e.g. Orbit Builders" value="ORBIT BUILDERS" style="font-weight: 700;">
        </div>

        <div class="form-grid-2">
          <div class="form-group">
            <label class="form-label" for="regDivision">Development Track Category</label>
            <select class="form-select" id="regDivision">
              <option value="App Development Track">App Development Track (Flutter, Swift, React Native)</option>
              <option value="Web Development Track">Web Development Track (Next.js, Full-Stack Web)</option>
              <option value="Emerging Systems & AI Track">Emerging Systems & AI Track (LLMs, Agentic)</option>
            </select>
          </div>
          <div class="form-group">
            <label class="form-label" for="regAlliance">Target Focus Theme</label>
