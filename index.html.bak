            <div class="badge-stub-row">
              <div class="stub-notch stub-notch-left"></div>
              <div class="stub-dash-line"></div>
              <div class="stub-notch stub-notch-right"></div>
            </div>

            <div class="badge-footer-telemetry">
              <span>VENUE: 28°38'N 77°13'E NEW DELHI</span>
              <span>•</span>
              <span>STAGE PROTOCOL: ALL ACCESS</span>
              <span>•</span>
              <span class="text-amber">NON-TRANSFERABLE BUILDER PASS</span>
            </div>

          </div>
        </div>

        <!-- Action Control Buttons Below Pass -->
        <div style="margin-top: 22px; display: flex; gap: 10px; flex-wrap: wrap;">
          <button class="btn-offset-box" id="downloadPassBtn" type="button" style="flex: 1; min-width: 220px; justify-content: center;">
            <span class="btn-offset-shadow" aria-hidden="true"></span>
            <span class="btn-offset-content" style="background: var(--blueprint); color: #fff; width: 100%; justify-content: center; font-weight: 800; font-size: 0.9rem; padding: 11px 18px;">
              Download Official Pass (PNG) ↓
            </span>
          </button>
          
          <button class="btn-secondary" id="copyPassSerialBtn" type="button" style="padding: 10px 16px; font-family: var(--font-mono); font-size: 0.8rem; font-weight: 700;">
            Copy Pass Serial
          </button>

          <button class="btn-secondary" id="printPassBtn" type="button" style="padding: 10px 16px; font-family: var(--font-mono); font-size: 0.8rem; font-weight: 700;">
            Print Pass
          </button>

          <button class="btn-secondary" id="editPassBtn" type="button" style="padding: 10px 16px; font-family: var(--font-mono); font-size: 0.8rem;">
            ← Edit Details
          </button>
        </div>
      </div>

    </div>
  </div>

  <!-- ========================================================================
       FLOATING PALETTE SWITCHER WIDGET
       ======================================================================== -->
  <div class="palette-switcher-dock" id="paletteSwitcherDock">
    
    <!-- Popover Menu -->
    <div class="palette-dropdown-panel" id="paletteDropdownPanel" role="dialog" aria-label="Choose Color Palette">
      <div class="palette-panel-header">
        <span class="palette-panel-title">SELECT SITE PALETTE</span>
        <span style="font-family: var(--font-mono); font-size: 0.6rem; color: var(--ink-muted);">LIVE PREVIEW</span>
      </div>
      
      <div class="palette-options-list">
        
        <!-- 1. Vistaar Punk -->
        <button class="palette-option-btn active" data-theme="blueprint" type="button">
          <div class="palette-option-info">
            <span class="palette-option-name">Vistaar Punk</span>
            <span class="palette-option-desc">Official Logo: Neon Pink & Electric Lavender</span>
          </div>
          <div class="palette-option-preview">
            <span class="palette-option-dot" style="background: #FD5D9D;"></span>
            <span class="palette-option-dot" style="background: #7572C2;"></span>
            <span class="palette-option-dot" style="background: #0D0614;"></span>
            <span class="palette-option-dot" style="background: #FFFFFF;"></span>
          </div>
        </button>

        <!-- 2. Cyber Emerald -->
        <button class="palette-option-btn" data-theme="emerald" type="button">
          <div class="palette-option-info">
            <span class="palette-option-name">Cyber Emerald</span>
            <span class="palette-option-desc">Terminal Matrix & High-Volt Mint</span>
          </div>
          <div class="palette-option-preview">
            <span class="palette-option-dot" style="background: #065F46;"></span>
            <span class="palette-option-dot" style="background: #10B981;"></span>
            <span class="palette-option-dot" style="background: #F2F7F4;"></span>
            <span class="palette-option-dot" style="background: #08170F;"></span>
          </div>
        </button>

        <!-- 3. Electric Violet -->
        <button class="palette-option-btn" data-theme="violet" type="button">
          <div class="palette-option-info">
            <span class="palette-option-name">Electric Violet</span>
            <span class="palette-option-desc">Modern AI & Ultraviolet Glow</span>
          </div>
          <div class="palette-option-preview">
            <span class="palette-option-dot" style="background: #5B21B6;"></span>
            <span class="palette-option-dot" style="background: #8B5CF6;"></span>
            <span class="palette-option-dot" style="background: #F7F5FC;"></span>
            <span class="palette-option-dot" style="background: #120B24;"></span>
          </div>
        </button>

        <!-- 4. Solar Orange -->
        <button class="palette-option-btn" data-theme="solar" type="button">
          <div class="palette-option-info">
            <span class="palette-option-name">Solar Orange</span>
            <span class="palette-option-desc">YC Founder Sprint & Industrial</span>
          </div>
          <div class="palette-option-preview">
            <span class="palette-option-dot" style="background: #C2410C;"></span>
            <span class="palette-option-dot" style="background: #F97316;"></span>
            <span class="palette-option-dot" style="background: #FAF7F2;"></span>
            <span class="palette-option-dot" style="background: #191411;"></span>
          </div>
        </button>

        <!-- 5. Monochrome Brutalist -->
        <button class="palette-option-btn" data-theme="monochrome" type="button">
          <div class="palette-option-info">
            <span class="palette-option-name">Monochrome Brutalist</span>
            <span class="palette-option-desc">Swiss Minimalist Grid & Royal Cobalt</span>
          </div>
          <div class="palette-option-preview">
            <span class="palette-option-dot" style="background: #171717;"></span>
            <span class="palette-option-dot" style="background: #2563EB;"></span>
            <span class="palette-option-dot" style="background: #F5F5F4;"></span>
            <span class="palette-option-dot" style="background: #0A0A0A;"></span>
          </div>
        </button>

      </div>
    </div>

    <!-- Toggle Trigger Button -->
    <button class="palette-trigger-btn" id="paletteTriggerBtn" type="button" aria-expanded="false" aria-label="Toggle Color Palette Menu">
      <div class="palette-swatch-dots">
        <span class="palette-swatch-dot" id="activeDot1" style="background: var(--blueprint);"></span>
        <span class="palette-swatch-dot" id="activeDot2" style="background: var(--amber);"></span>
      </div>
      <span id="activePaletteLabel">PALETTE: VISTAAR PUNK</span>
      <span style="font-size: 0.6rem; opacity: 0.7;">▲</span>
    </button>

  </div>

</body>
</html>
