<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Vistaara — Build. Solve. Connect. | Official Student Hackathon 2026</title>
  <meta name="description" content="Vistaara is a premier student hackathon in App Development and Web Development for builders aged 14–26. 200–300 participants, 50+ teams, 15+ industry mentors, and direct founder interaction. Build. Solve. Connect.">
  <link rel="icon" href="assets/favicon.svg" type="image/svg+xml">
  <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">
  <meta http-equiv="Pragma" content="no-cache">
  <meta http-equiv="Expires" content="0">
  
  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Anton&family=Bebas+Neue&family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;600;700;800&family=Space+Mono:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">
  
  <link rel="stylesheet" href="styles.css?v=4.0.0">
  <style>
    .modal-backdrop.open, .modal-backdrop.active {
      display: flex !important;
      opacity: 1 !important;
      visibility: visible !important;
      pointer-events: auto !important;
    }
  </style>
  
  <!-- Three.js -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
  <script src="app.js?v=4.0.0" defer></script>
</head>
<body>

  <!-- Custom Interactive Cursor -->
  <div class="custom-cursor-dot" aria-hidden="true"></div>
  <div class="custom-cursor-ring" aria-hidden="true"></div>

  <!-- Scroll Progress Indicator -->
  <div class="scroll-progress-bar" id="scrollProgressBar" aria-hidden="true"></div>

  <!-- Minimal Background Grid -->
  <div class="grid-bg-overlay" aria-hidden="true"></div>

  <!-- ========================================================================
  <!-- ========================================================================
       VISTAARA EDITORIAL BRUTALIST HEADER
       ======================================================================== -->
  <header class="editorial-header" id="topbar">
    <div class="editorial-header-left">
      <!-- Left Brand Mark -->
      <a href="#hero" class="editorial-brand" data-cursor="VISTAARA">
        <img src="assets/logo.png" alt="Vistaara Logo" class="editorial-brand-logo">
        <span class="editorial-brand-text">VISTAARA</span>
      </a>

      <!-- Navigation Links -->
      <nav class="editorial-nav-strip" aria-label="Main Navigation">
        <a href="#tracks" class="editorial-nav-link">Tracks</a>
        <a href="#evaluator" class="editorial-nav-link">Evaluator</a>
        <a href="#timeline" class="editorial-nav-link">Schedule</a>
        <a href="#prizes" class="editorial-nav-link">Prizes</a>
        <a href="#terminal" class="editorial-nav-link">Terminal</a>
        <a href="#faq" class="editorial-nav-link">FAQ</a>
      </nav>
    </div>

    <!-- Center 100 Pill Badge (Matches Reference Top Center Pill) -->
    <div class="editorial-badge-pill" aria-hidden="true">
      <span>100</span>
    </div>

    <!-- Right Action Container -->
    <div class="editorial-header-right">
      <!-- Iconic Square Neon Action Arrow Button (↗) - Triggers Pass Modal -->
      <button class="square-arrow-btn open-register-modal-btn" type="button" title="Claim Builder Pass / Register" aria-label="Claim Builder Pass">
        <span>↗</span>
      </button>

      <!-- Mobile Menu Toggle -->
      <button class="mobile-menu-btn" id="mobileMenuBtn" type="button" aria-label="Open Navigation Menu">
        <span>MENU</span>
      </button>
    </div>
  </header>

  <!-- Mobile Nav Drawer -->
  <div class="mobile-nav-drawer" id="mobileNavDrawer">
    <a href="#tracks" class="mobile-nav-link">Tracks & Themes</a>
    <a href="#evaluator" class="mobile-nav-link">Project Evaluator</a>
    <a href="#timeline" class="mobile-nav-link">Schedule</a>
    <a href="#prizes" class="mobile-nav-link">Prizes</a>
    <a href="#terminal" class="mobile-nav-link">Pass Terminal</a>
    <a href="#faq" class="mobile-nav-link">FAQ</a>
    <button class="square-arrow-btn open-register-modal-btn" style="width: 100%; height: 48px; margin-top: 12px; gap: 8px; font-size: 0.9rem;">
      <span>CLAIM BUILDER PASS ↗</span>
    </button>
  </div>

  <main>

    <!-- ========================================================================
         EDITORIAL BRUTALIST HERO: SPLIT-SCREEN INVERTED MONUMENT
         ======================================================================== -->
    <section class="editorial-hero" id="hero">
      
      <!-- Upper Zone: Dark Grayscale Photography & Lead Hierarchy -->
      <div class="hero-upper-zone">
        
        <!-- Left Column: Vertical Index Nav + Lead + Tagline + Monumental VISTAARA Title -->
        <div class="hero-upper-left">
          
          <!-- Mini Left Vertical Nav Strip (Matches Reference Left Column) -->
          <nav class="hero-vertical-nav" aria-label="Hero Index">
            <a href="#hero" class="hero-nav-item">HOME</a>
            <a href="#tracks" class="hero-nav-item">TRACKS</a>
            <a href="#evaluator" class="hero-nav-item">EVALUATOR</a>
            <a href="#timeline" class="hero-nav-item">SCHEDULE</a>
            <a href="#terminal" class="hero-nav-item">TERMINAL</a>
            <button type="button" class="hero-nav-item open-register-modal-btn">PASS</button>
          </nav>

          <!-- Lead Editorial Paragraph & Monumental VISTAARA Title -->
          <div class="hero-lead-block">
            <p class="hero-editorial-lead">
              A BRUTAL, BEAUTIFUL SPRINT ACROSS SYSTEMS, ARCHITECTURE, AND THE EDGE OF PRODUCTION CODE.
            </p>
                <div>
                  <label style="display: block; font-family: var(--font-mono); font-size: 0.65rem; color: #cbd5e1; text-transform: uppercase; margin-bottom: 4px;">
                    Registered Team Name:
                  </label>
                  <input type="text" id="termTeamName" class="term-input" placeholder="e.g. Orbit Builders" value="ORBIT BUILDERS">
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px;">
                  <div>
                    <label style="display: block; font-family: var(--font-mono); font-size: 0.65rem; color: #cbd5e1; text-transform: uppercase; margin-bottom: 4px;">
                      Track Category:
                    </label>
                    <select id="termTrackSelect" class="term-input">
                      <option value="App Development Track">App Development</option>
                      <option value="Web Development Track">Web Development</option>
                      <option value="Emerging Systems & AI">Emerging Systems & AI</option>
                    </select>
                  </div>
                  <div>
                    <label style="display: block; font-family: var(--font-mono); font-size: 0.65rem; color: #cbd5e1; text-transform: uppercase; margin-bottom: 4px;">
                      Focus Theme:
                    </label>
                    <select id="termThemeSelect" class="term-input">
                      <option value="AI Central">AI Central</option>
                      <option value="Cyber Security">Cyber Security</option>
                      <option value="Cloud Computing">Cloud Computing</option>
                      <option value="FinTech">FinTech</option>
                      <option value="Blockchain">Blockchain</option>
                      <option value="Healthcare">Healthcare</option>
                      <option value="IoT">IoT</option>
                      <option value="Web3">Web3</option>
                      <option value="Education">Education</option>
                      <option value="Sustainability">Sustainability</option>
                    </select>
                  </div>
                </div>
              </div>

              <div style="display: flex; gap: 8px; margin-top: 4px;">
                <button class="btn-offset-box" id="termGeneratePassBtn" style="flex: 1;" type="button">
                  <span class="btn-offset-shadow" aria-hidden="true"></span>
                  <span class="btn-offset-content" id="termGeneratePassBtnContent" style="background: var(--amber); color: #12172B; width: 100%; justify-content: center; font-weight: 700;">
                    Generate Official Pass →
                  </span>
                </button>
              </div>

            </div>

            <!-- View 3: Live In-Terminal VIP Builder Badge Display -->
            <div class="terminal-body" id="termViewBadge" style="display: none;">
              <div class="term-badge-wrapper">
                <div class="term-badge-header">
                  <img src="assets/logo.png" alt="Vistaar Logo" style="height: 32px; width: auto; object-fit: contain; filter: drop-shadow(0 0 8px rgba(253, 93, 157, 0.5));">
                  <div>
                    <div style="font-family: var(--font-display); font-size: 0.95rem; font-weight: 900; color: #fff;">VISTAARA 2026</div>
                    <div style="font-family: var(--font-mono); font-size: 0.58rem; color: var(--blueprint); font-weight: 700;">VIP BUILDER CREDENTIAL</div>
                  </div>
                  <span class="badge-serial-stencil" id="termPassCardSerial" style="margin-left: auto; font-size: 0.72rem;">VST-2026-X89</span>
                </div>

                <div class="term-badge-body" style="margin-top: 10px;">
                  <div class="badge-field-label">TEAM CALL-SIGN</div>
                  <div class="badge-team-hero" id="termPassCardTeam" style="font-size: 1.45rem; line-height: 1.1;">ORBIT BUILDERS</div>
                  
                  <div class="badge-tag-pills" style="margin: 6px 0;">
                    <span class="badge-tag-track" id="termPassCardTrack" style="font-size: 0.62rem;">APP DEVELOPMENT</span>
                    <span class="badge-tag-theme" id="termPassCardTheme" style="font-size: 0.62rem;">AI CENTRAL</span>
                  </div>

                  <div style="display: grid; grid-template-columns: 1fr auto; gap: 12px; align-items: center; margin-top: 8px;">
                    <div style="font-family: var(--font-mono); font-size: 0.65rem; color: #94a3b8; display: flex; flex-direction: column; gap: 4px;">
                      <div>LEAD: <strong id="termPassCardCaptain" style="color: #fff;">ARYAN SHARMA</strong></div>
                      <div>STATUS: <strong style="color: #4ade80;">10-DAY MAIL VERIFIED</strong></div>
                      <div>ACCESS: <span style="color: #e2e8f0;">ALL ARENA &amp; MAKER LABS</span></div>
                    </div>

                    <!-- Mini QR Code Matrix -->
                    <div class="scannable-qr-wrap" style="width: 85px; height: 85px; padding: 4px;">
                      <div class="qr-laser-scanner"></div>
                      <svg class="badge-qr-svg" viewBox="0 0 120 120" width="75" height="75" aria-label="Official Pass QR Code">
                        <rect width="120" height="120" fill="#ffffff" rx="3"/>
                        <rect x="10" y="10" width="34" height="34" fill="#0c101c"/>
                        <rect x="16" y="16" width="22" height="22" fill="#ffffff"/>
                        <rect x="21" y="21" width="12" height="12" fill="#0052cc"/>
                        <rect x="76" y="10" width="34" height="34" fill="#0c101c"/>
                        <rect x="82" y="16" width="22" height="22" fill="#ffffff"/>
                        <rect x="87" y="21" width="12" height="12" fill="#0052cc"/>
                        <rect x="10" y="76" width="34" height="34" fill="#0c101c"/>
                        <rect x="16" y="82" width="22" height="22" fill="#ffffff"/>
                        <rect x="21" y="87" width="12" height="12" fill="#0052cc"/>
                        <rect x="52" y="14" width="16" height="8" fill="#ffb703"/>
                        <rect x="52" y="28" width="8" height="14" fill="#00d1ff"/>
                        <rect x="50" y="50" width="20" height="20" fill="#0052cc"/>
                        <rect x="76" y="52" width="14" height="14" fill="#0c101c"/>
                        <rect x="56" y="100" width="28" height="10" fill="#0052cc"/>
                        <rect x="96" y="100" width="14" height="10" fill="#ffb703"/>
                      </svg>
                    </div>
                  </div>
                </div>

                <!-- Action Toolbar Inside Terminal -->
                <div style="display: flex; gap: 8px; margin-top: 14px; flex-wrap: wrap;">
                  <button class="btn-offset-box" id="termDownloadPassBtn" type="button" style="flex: 1;">
                    <span class="btn-offset-shadow" aria-hidden="true"></span>
                    <span class="btn-offset-content" style="background: var(--blueprint); color: #fff; width: 100%; justify-content: center; font-weight: 700; font-size: 0.78rem; padding: 8px 12px;">
                      Download PNG ↓
                    </span>
                  </button>
                  <button class="term-mini-demo-btn" id="termOpenModalBtn" type="button" style="padding: 8px 12px; font-size: 0.75rem;">
                    Fullscreen Modal ↗
                  </button>
                  <button class="term-mini-demo-btn" id="termEditPassBtn" type="button" style="padding: 8px 10px; font-size: 0.75rem; border-color: #64748b; color: #94a3b8;">
                    ← Edit
                  </button>
                </div>
              </div>
            </div>

          </div>

        </div>

        <!-- Clean Minimalist Stats & Countdown Strip -->
        <div class="hero-stats-strip">
          
          <div class="stat-item">
            <span class="stat-value text-orange" style="color: var(--amber); font-size: 1.5rem;">TO BE ANNOUNCED</span>
            <span class="stat-label">Prize Pool & Seed Grants</span>
          </div>

          <div class="stat-item">
            <span class="stat-value" style="color: var(--blueprint);">200–300</span>
            <span class="stat-label">Student Builders (Ages 14–26)</span>
          </div>

          <div class="stat-item">
            <span class="stat-value">50+ TEAMS</span>
            <span class="stat-label">Original App & Web Products</span>
          </div>

          <div class="stat-item">
            <span class="stat-value" style="color: var(--energy-cyan);">15+ MENTORS</span>
            <span class="stat-label">10+ Tech Companies & Founders</span>
          </div>

          <!-- Countdown -->
          <div class="countdown-box">
            <div class="countdown-label">
              <span>T-MINUS HACKATHON LAUNCH</span>
              <span class="radar-pulse" style="width: 5px; height: 5px; background: var(--amber);"></span>
            </div>
            <div class="countdown-digits">
              <div class="countdown-unit">
                <span id="cntDays">42</span>
                <span class="unit-name">DAYS</span>
              </div>
              <span>:</span>
              <div class="countdown-unit">
                <span id="cntHours">08</span>
                <span class="unit-name">HRS</span>
              </div>
              <span>:</span>
              <div class="countdown-unit">
                <span id="cntMins">30</span>
                <span class="unit-name">MIN</span>
              </div>
              <span>:</span>
              <div class="countdown-unit">
                <span id="cntSecs" style="color: var(--amber);">00</span>
                <span class="unit-name">SEC</span>
              </div>
            </div>
          </div>

        </div>

      </div>
    </section>







    <!-- ========================================================================
         RADICAL DIAGONAL PUNK HAZARD RIBBON DIVIDER
         ======================================================================== -->
    <div class="punk-hazard-ribbon" aria-hidden="true">
      <div class="punk-hazard-inner">
        <span>VISTAARA 2026 SPRINT</span>
        <span>•</span>
        <span>48-HOUR HIGH-VOLTAGE BUILD</span>
        <span>•</span>
        <span>ZERO CORPORATE SLOP</span>
        <span>•</span>
        <span>PURE PRODUCTION PROTOTYPES</span>
        <span>•</span>
        <span>50+ TEAMS</span>
        <span>•</span>
        <span>100% BUILDER-OWNED IP</span>
        <span>•</span>
        <span>APP &amp; WEB ARCHITECTURE</span>
        <span>•</span>
        <span>VISTAARA 2026 SPRINT</span>
        <span>•</span>
        <span>48-HOUR HIGH-VOLTAGE BUILD</span>
        <span>•</span>
        <span>ZERO CORPORATE SLOP</span>
        <span>•</span>
        <span>PURE PRODUCTION PROTOTYPES</span>
        <span>•</span>
        <span>50+ TEAMS</span>
        <span>•</span>
        <span>100% BUILDER-OWNED IP</span>
        <span>•</span>
        <span>APP &amp; WEB ARCHITECTURE</span>
      </div>
    </div>
    <section id="tracks">
      <div class="site-container">
        
        <div class="section-header-split">
          <div>
            <div class="section-eyebrow" style="color: var(--blueprint);">Tracks & Themes</div>
            <h2 class="section-title">TWO CORE TRACKS, KEY FOCUS DOMAINS</h2>
          </div>
          <div>
            <p class="section-desc">
              Over the course of the event, participants form teams of 2 to 4, develop original mobile apps and web products, receive mentorship from experienced builders, and compete before a panel of industry professionals.
            </p>
          </div>
        </div>

        <div class="division-tabs-bar">
          <button class="division-tab-btn active" data-division="app" type="button">
            <span>01: App Development Track</span>
          </button>
          <button class="division-tab-btn" data-division="web" type="button">
            <span>02: Web Development Track</span>
          </button>
          <button class="division-tab-btn" data-division="open" type="button">
            <span>03: Open Innovation & Emerging Tech</span>
          </button>
        </div>

        <!-- Track 1: App Development -->
        <div class="division-content-pane active" id="divPane-app">
          <div class="division-showcase-card bracket">
            <div>
              <div class="hud-badge" style="margin-bottom: 12px; color: var(--energy-cyan); border-color: var(--energy-cyan);">TRACK 01: MOBILE APP ARCHITECTURE</div>
              <h3 style="font-size: 1.8rem; color: var(--ink); margin-bottom: 8px;">App Development Track</h3>
              <p style="color: var(--ink-secondary); line-height: 1.6; font-size: 0.92rem;">
                Teams design and build an original mobile app from scratch, addressing real-world challenges through intuitive UX and robust architecture.
              </p>
              
              <table class="division-specs-table">
                <tbody>
                  <tr><td>TARGET PLATFORMS</td><td>iOS (Swift), Android (Kotlin), Flutter, or React Native</td></tr>
                  <tr><td>PARTICIPANT AGES</td><td>Students aged 14–26 (High School & Collegiate)</td></tr>
                  <tr><td>TEAM ROSTER</td><td>2 to 4 Student Builders</td></tr>
                  <tr><td>CORE CRITERIA</td><td>Real-World Problem, Touch UX, Offline Persistence, Sensor Inputs</td></tr>
                  <tr><td>DELIVERABLES</td><td>Working Mobile Build (APK/Sim), GitHub Repo, 3-min Demo</td></tr>
                </tbody>
              </table>

              <div style="margin-top: 20px;">
                <button class="btn-offset-box open-register-modal-btn" type="button">
                  <span class="btn-offset-shadow" aria-hidden="true"></span>
                  <span class="btn-offset-content" style="background: #12172B; color: #fff; border-color: #12172B;">Register App Dev Team →</span>
                </button>
              </div>
            </div>

            <div style="background: var(--paper); border: 1.5px solid var(--line-light); border-radius: var(--radius-xs); padding: 20px; display: flex; flex-direction: column; justify-content: space-between;">
              <div>
                <h4 style="font-family: var(--font-mono); font-size: 0.76rem; color: var(--blueprint); text-transform: uppercase;">Engineering Rubric</h4>
                <ul style="list-style: none; margin-top: 12px; display: flex; flex-direction: column; gap: 8px; font-size: 0.85rem; color: var(--ink-secondary);">
                  <li><strong>• Intuitive UX & Design:</strong> Fluid touch navigation, accessibility, and visual polish.</li>
                  <li><strong>• Resilient Architecture:</strong> Local caching, clean state management, and offline support.</li>
                  <li><strong>• Real Problem Validation:</strong> Solves an identified friction point for real users.</li>
                </ul>
              </div>
              <div style="padding-top: 14px; border-top: 1px dashed var(--line-light); font-family: var(--font-mono); font-size: 0.72rem; color: var(--blueprint); font-weight: bold;">
                PRIZE: TO BE ANNOUNCED (Track Champion Grants)
              </div>
            </div>
          </div>
        </div>

        <!-- Track 2: Web Development -->
        <div class="division-content-pane" id="divPane-web">
          <div class="division-showcase-card bracket">
            <div>
              <div class="hud-badge" style="margin-bottom: 12px; color: var(--amber-dim); border-color: var(--amber-dim);">TRACK 02: FULL-STACK WEB PRODUCTS</div>
              <h3 style="font-size: 1.8rem; color: var(--ink); margin-bottom: 8px;">Web Development Track</h3>
              <p style="color: var(--ink-secondary); line-height: 1.6; font-size: 0.92rem;">
                Teams design and build a working web product, grounded in a real problem and shaped by the industry perspective shared throughout Vistaara.
              </p>
              
              <table class="division-specs-table">
                <tbody>
                  <tr><td>TARGET PLATFORMS</td><td>Next.js, React, Vue, SvelteKit, Node, Python, Go backend</td></tr>
                  <tr><td>PARTICIPANT AGES</td><td>Students aged 14–26 (High School & Collegiate)</td></tr>
                  <tr><td>TEAM ROSTER</td><td>2 to 4 Student Builders</td></tr>
                  <tr><td>CORE CRITERIA</td><td>Full-Stack Architecture, REST/GraphQL APIs, Data Layer, Real-time Sync</td></tr>
                  <tr><td>DELIVERABLES</td><td>Live Deployed URL, Open-Source GitHub Repository, Demo Deck</td></tr>
                </tbody>
              </table>

              <div style="margin-top: 20px;">
                <button class="btn-offset-box open-register-modal-btn" type="button">
                  <span class="btn-offset-shadow" aria-hidden="true"></span>
                  <span class="btn-offset-content" style="background: #12172B; color: #fff; border-color: #12172B;">Register Web Dev Team →</span>
                </button>
              </div>
            </div>

            <div style="background: var(--paper); border: 1.5px solid var(--line-light); border-radius: var(--radius-xs); padding: 20px; display: flex; flex-direction: column; justify-content: space-between;">
              <div>
                <h4 style="font-family: var(--font-mono); font-size: 0.76rem; color: var(--blueprint); text-transform: uppercase;">Engineering Rubric</h4>
                <ul style="list-style: none; margin-top: 12px; display: flex; flex-direction: column; gap: 8px; font-size: 0.85rem; color: var(--ink-secondary);">
                  <li><strong>• Responsive Cross-Device:</strong> Desktop, tablet, and mobile layout parity.</li>
                  <li><strong>• Robust Backend & Auth:</strong> Secure API design, session security, database normalization.</li>
                  <li><strong>• Real-World Grounding:</strong> Product architecture shaped by industry perspectives.</li>
                </ul>
              </div>
              <div style="padding-top: 14px; border-top: 1px dashed var(--line-light); font-family: var(--font-mono); font-size: 0.72rem; color: var(--amber-dim); font-weight: bold;">
                PRIZE: TO BE ANNOUNCED (Track Champion Grants)
              </div>
            </div>
          </div>
        </div>

        <!-- Track 3: Open Innovation & Emerging Tech -->
        <div class="division-content-pane" id="divPane-open">
          <div class="division-showcase-card bracket">
            <div>
              <div class="hud-badge" style="margin-bottom: 12px; color: var(--blueprint); border-color: var(--blueprint);">TRACK 03: EMERGING SYSTEMS & AI</div>
              <h3 style="font-size: 1.8rem; color: var(--ink); margin-bottom: 8px;">Open Innovation & Emerging Tech Track</h3>
              <p style="color: var(--ink-secondary); line-height: 1.6; font-size: 0.92rem;">
                Cross-platform systems, AI agent integrations, IoT telemetry, and Web3 decentralization solving pressing civic and community pain points.
              </p>
              
              <table class="division-specs-table">
                <tbody>
                  <tr><td>TARGET PLATFORMS</td><td>AI Agents / LLMs, IoT Microcontrollers, Web3 / Smart Contracts</td></tr>
                  <tr><td>PARTICIPANT AGES</td><td>Students aged 14–26 (High School & Collegiate)</td></tr>
                  <tr><td>TEAM ROSTER</td><td>2 to 4 Student Builders</td></tr>
                  <tr><td>CORE CRITERIA</td><td>Novel Problem Framing, Multi-Modal Systems, Practical Utility</td></tr>
                  <tr><td>DELIVERABLES</td><td>Working Prototype Pipeline, GitHub Repository, Live Defense</td></tr>
                </tbody>
              </table>

              <div style="margin-top: 20px;">
                <button class="btn-offset-box open-register-modal-btn" type="button">
                  <span class="btn-offset-shadow" aria-hidden="true"></span>
                  <span class="btn-offset-content" style="background: #12172B; color: #fff; border-color: #12172B;">Register Open Tech Team →</span>
                </button>
              </div>
            </div>

            <div style="background: var(--paper); border: 1.5px solid var(--line-light); border-radius: var(--radius-xs); padding: 20px; display: flex; flex-direction: column; justify-content: space-between;">
