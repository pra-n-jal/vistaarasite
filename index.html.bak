                <div class="calc-row-item">
                  <div class="calc-item-info">
                    <span class="calc-item-name">Problem Relevance & Depth</span>
                    <span class="calc-item-pts">+1 Pt / Score (Max 15)</span>
                  </div>
                  <div class="calc-stepper">
                    <button class="stepper-btn" data-key="autoNear" data-action="dec" data-min="0" data-max="15" type="button">-</button>
                    <span class="stepper-val" id="val-autoNear">12</span>
                    <button class="stepper-btn" data-key="autoNear" data-action="inc" data-min="0" data-max="15" type="button">+</button>
                  </div>
                </div>

                <div class="calc-row-item">
                  <div class="calc-item-info">
                    <span class="calc-item-name">User Research & Market Validation</span>
                    <span class="calc-item-pts">+1 Pt / Score (Max 15)</span>
                  </div>
                  <div class="calc-stepper">
                    <button class="stepper-btn" data-key="autoFar" data-action="dec" data-min="0" data-max="15" type="button">-</button>
                    <span class="stepper-val" id="val-autoFar">11</span>
                    <button class="stepper-btn" data-key="autoFar" data-action="inc" data-min="0" data-max="15" type="button">+</button>
                  </div>
                </div>
              </div>

              <!-- 02: Technical Architecture & Code -->
              <div class="calc-section-title">02: Technical Architecture & Code Quality (40 Pts)</div>
              <div class="calc-inputs-group">
                <div class="calc-row-item">
                  <div class="calc-item-info">
                    <span class="calc-item-name">Clean Architecture & Modularity</span>
                    <span class="calc-item-pts">+1 Pt / Score (Max 20)</span>
                  </div>
                  <div class="calc-stepper">
                    <button class="stepper-btn" data-key="teleNear" data-action="dec" data-min="0" data-max="20" type="button">-</button>
                    <span class="stepper-val" id="val-teleNear">16</span>
                    <button class="stepper-btn" data-key="teleNear" data-action="inc" data-min="0" data-max="20" type="button">+</button>
                  </div>
                </div>

                <div class="calc-row-item">
                  <div class="calc-item-info">
                    <span class="calc-item-name">API, Cloud & AI Integration</span>
                    <span class="calc-item-pts">+1 Pt / Score (Max 20)</span>
                  </div>
                  <div class="calc-stepper">
                    <button class="stepper-btn" data-key="teleFar" data-action="dec" data-min="0" data-max="20" type="button">-</button>
                    <span class="stepper-val" id="val-teleFar">15</span>
                    <button class="stepper-btn" data-key="teleFar" data-action="inc" data-min="0" data-max="20" type="button">+</button>
                  </div>
                </div>
              </div>

              <!-- 03: UI/UX Design & Demo -->
