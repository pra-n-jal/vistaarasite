              <div class="calc-inputs-group">
                <div class="calc-row-item">
                  <div class="calc-item-info">
                    <span class="calc-item-name">UI/UX Intuition & Responsive Design</span>
                    <span class="calc-item-pts">+1 Pt / Score (Max 15)</span>
                  </div>
                  <div class="calc-stepper">
                    <button class="stepper-btn" data-key="teleSig" data-action="dec" data-min="0" data-max="15" type="button">-</button>
                    <span class="stepper-val" id="val-teleSig">13</span>
                    <button class="stepper-btn" data-key="teleSig" data-action="inc" data-min="0" data-max="15" type="button">+</button>
